# ── Groq ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=tu_api_key_de_groq_aqui
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Segundos antes de abandonar una llamada. Sin esto, langchain-groq espera
# indefinidamente y una peticion colgada bloquea el worker de Flask.
GROQ_TIMEOUT_S=10
# Reintentos por llamada. El default de la libreria es 2: con una clave
# invalida son 3 llamadas fallidas por request.
GROQ_MAX_RETRIES=1
GROQ_MAX_TOKENS=300
# Tope de tamano para las imagenes de boleta, en MB antes de codificar en
# base64 (que las infla ~33%).
GROQ_MAX_IMAGEN_MB=4

# ── Limite de tasa ────────────────────────────────────────────────────────────
# Los endpoints que llaman a Groq no piden credenciales: sin tope, cualquiera
# puede agotar la cuota. Con varios workers hay que apuntar a Redis.
RATELIMIT_ENABLED=1
RATELIMIT_STORAGE_URI=memory://

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=5000
# Dejar en 0 fuera de desarrollo: el depurador de Werkzeug permite ejecutar
# codigo de forma remota.
FLASK_DEBUG=0

# ── Geocodificacion inversa (Nominatim / OpenStreetMap) ───────────────────────
# OBLIGATORIO para que funcione la deteccion automatica de ubicacion. Su
# politica de uso exige identificar la aplicacion y dar una via de contacto;
# sin esta variable el backend NO llama al servicio y la app pide la ubicacion
# a mano. Poner el alias de correo del equipo.
NOMINATIM_CONTACTO=team@example.com
NOMINATIM_APP=VolticvS/1.0
NOMINATIM_TIMEOUT_S=8
# Peticiones salientes por segundo permitidas por la politica: 1.
NOMINATIM_INTERVALO_S=1

# ── OCI Object Storage (Fase E: modelo entrenado) ─────────────────────────────
# OPCIONAL. Sin OCI_BUCKET_NAMESPACE + OCI_BUCKET_NAME, la app no intenta
# conectarse a OCI y usa el modelo que ya tenga en local (o los umbrales fijos
# si tampoco hay ninguno) — igual que con Nominatim, se degrada, no se cae.
#
# Autenticacion: si el proceso corre DENTRO de una VM de OCI Compute con un
# dynamic group + policy que le den permiso de lectura sobre el bucket, no
# hace falta ninguna clave aca — se autentica solo (Instance Principal). Eso
# se configura en la consola de OCI, no en este archivo. Estas variables
# abajo son solo para desarrollo LOCAL, en una maquina que no es una VM de OCI:
#   OCI_CONFIG_PROFILE=DEFAULT   (perfil de ~/.oci/config)
OCI_BUCKET_NAMESPACE=
OCI_BUCKET_NAME=
OCI_MODEL_OBJECT=clasificador_energetico.joblib
OCI_METADATOS_OBJECT=metadatos.json
OCI_CONFIG_PROFILE=DEFAULT

# ── Servidor de produccion (gunicorn, solo en contenedor) ─────────────────────
# MAYOR que GROQ_TIMEOUT_S por reintentos: con el default de 30 s, gunicorn
# mataria al worker antes de que el modelo alcanzara a responder.
GUNICORN_TIMEOUT=60
# 1 worker con hilos, no varios procesos: el limite de tasa y la cache de
# geocodificacion viven en memoria del proceso. Para subir de 1 hay que apuntar
# antes RATELIMIT_STORAGE_URI a Redis.
GUNICORN_WORKERS=1
GUNICORN_THREADS=8

# ── Documentacion de la API ───────────────────────────────────────────────────
# Apagada por defecto: publicar el catalogo de endpoints que consumen servicios
# de pago facilita el abuso que mitiga el limite de tasa. Con 1 se sirve el
# contrato en /openapi.yaml y, si instalaste requirements-dev.txt, la interfaz
# visual en /apidocs.
ENABLE_API_DOCS=1

# ── Solo para Docker ──────────────────────────────────────────────────────────
# Puerto en TU maquina, independiente del interno (PORT). En macOS el 5000 lo
# ocupa el receptor de AirPlay, de ahi que se puedan separar.
HOST_PORT=5000
# Con 1, la imagen incluye Swagger UI (~9 MB) y /apidocs funciona. Se aplica al
# CONSTRUIR, no al arrancar:  INSTALAR_DOCS=1 docker compose build
INSTALAR_DOCS=0
